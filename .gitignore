# Environment & Secrets
# Real credentials live ONLY in these ignored files — nothing else.
.env
.env.local
*.env
# text.txt is deprecated (its contents moved to frontend/.env.local) but stays
# ignored so a recreated dump of keys can never be committed by accident.
text.txt

# Python / local tooling (supabase/tools/generate_seed.py)
__pycache__/
*.py[cod]
*$py.class
*.sqlite3
.venv/
.pytest_cache/

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/.tmp/
supabase/node_modules/

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp
