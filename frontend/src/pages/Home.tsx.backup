import React, { useState } from 'react';
import { Hero } from '../components/Hero';
import { HomeShowcase } from '../components/HomeShowcase';
import { Reveal } from '../components/motion/Reveal';
import { Station, Song, Genre, GenreCategory } from '../types';
import { useI18n } from '../context/I18nContext';
import { ChevronDown, ChevronUp } from 'lucide-react';
import { groupGenresByCategory, resolveCategories } from '../utils/genreTaxonomy';
import { RecommendSongSection } from '../components/RecommendSongSection';

interface HomeProps {
  stations: Station[];
  featuredSongs: Song[];
  newSongs: Song[];
  trendingSongs: Song[];
  genres: Genre[];
  categories?: GenreCategory[];
  decades: { decade: string; count: number }[];
  onSelectGenre: (genreSlug: string) => void;
  onSelectDecade: (decade: string) => void;
  onExploreCatalog: () => void;
}

export const Home: React.FC<HomeProps> = ({
  stations,
  featuredSongs,
  newSongs,
  trendingSongs,
  genres,
  categories,
  decades,
  onSelectGenre,
  onSelectDecade,
  onExploreCatalog,
}) => {
  const { locale } = useI18n();
  const [openFaq, setOpenFaq] = useState<number | null>(null);
  const resolvedCategories = resolveCategories(categories || []);

  const faqs = [
    {
      q: 'बजेको चिया पसल के हो र यो कसरी काम गर्दछ?',
      q_en: 'What is Bajeko Chiya Pasal and how does it operate?',
      a: 'बजेको चिया पसल एक मौलिक नेपाली संगीत रेडियो प्लेटफर्म हो। यहाँ विभिन्न सांगीतिक परिवेश (जस्तै चिया पसल, पुरानो रेडियो, बस यात्रा) छनौट गरी निरन्तर कालजयी गीतहरू सुन्न सकिन्छ। सम्पूर्ण प्लेब्याक आधिकारिक युट्युब प्लेयर इम्बेड मार्फत हुन्छ।',
      a_en: 'Bajeko Chiya Pasal is an original Nepali music radio experience designed around nostalgic themes (tea shops, vintage radio, highway buses). All playback is powered strictly via official YouTube embeds without unauthorized streaming or audio extraction.',
    },
    {
      q: 'के गीत सुन्न खाता खोल्नु अनिवार्य छ?',
      q_en: 'Is an account mandatory to listen?',
      a: 'छैन। अतिथि प्रयोगकर्ताको रूपमा जो कोहीले पनि बिना दर्ता जुनसुकै स्टेसन वा गीत सुन्न र मनपर्ने सूचीमा थप्न सक्नुहुन्छ।',
      a_en: 'No. Anonymous guest listening is fully supported. You can tune in, shuffle stations, and save favorites immediately.',
    },
    {
      q: 'कुनै भिडियो नबजेमा वा प्रतिलिपि अधिकार सम्बन्धी उजुरी भएमा के गर्ने?',
      q_en: 'What if a video is unavailable or requires copyright moderation?',
      a: 'पृष्ठको माथि वा तल रहेको "प्रतिलिपि अधिकार तथा उजुरी" फारम मार्फत जानकारी गराउन सक्नुहुन्छ। हाम्रो टोलीले तत्काल समीक्षा गरी आवश्यक परेमा सामग्री हटाउनेछ।',
      a_en: 'You can submit an immediate report via the Content & Takedown form. Our administration promptly reviews tickets and unpublishes disputed content.',
    },
    {
      q: 'के अफलाइन हुँदा गीत बज्छ?',
      q_en: 'Can songs play when offline?',
      a: 'इन्टरफेस र क्याटलग अफलाइन सुरक्षित हुन्छ, तर युट्युबको आधिकारिक इम्बेड अडियो सुन्न सक्रिय इन्टरनेट जडान चाहिन्छ।',
      a_en: 'The app shell and catalog UI are cached via PWA, but live audio streaming requires an active internet connection per YouTube embed terms.',
    },
  ];

  return (
    <div className="space-y-16 pb-20">
      {/* 1. Hero with Integrated Vintage Radio Tuner */}
      <Hero stations={stations} onExploreCatalog={onExploreCatalog} />

      {/* 2. Main content column (Wall of Worlds → Decades → …) */}
      <Reveal variant="up" delay={60} className="space-y-16 pb-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <section className="space-y-4">
              <div className="text-center mb-8">
                <div className="flex items-center justify-center gap-2 text-xs font-mono text-neutral-500 uppercase tracking-widest mb-1">
                  <span>DECADES</span>
                </div>
                <h2 className="font-serif text-2xl font-black text-cream-100">
                  {locale === 'ne' ? 'युगान्तर संगीत' : 'Decades Music'}
                </h2>
              </div>

              <div className="space-y-6">
            {decades.map((d) => (
              <button
                key={d.decade}
                onClick={() => onSelectDecade(d.decade)}
                className="pd-lift p-4 rounded-2xl bg-black/60 hover:bg-red-600 text-center transition-all duration-300 ease-out hover:scale-105 active:scale-95 border border-white/10 hover:border-red-500/50 shadow-md group"
              >
                <span className="font-serif text-lg font-bold block text-white group-hover:text-white">{d.decade}</span>
         {/* 4. Browse — explore by genre */}
         <section className="space-y-4">
           <div className="text-center mb-8">
             <div className="flex items-center justify-center gap-2 text-xs font-mono text-neutral-500 uppercase tracking-widest mb-1">
               <span>BROWSE</span>
             </div>
             <h2 className="font-serif text-2xl font-black text-cream-100">
               {locale === 'ne' ? 'सांगीतिक विधा वर्गीकरण' : 'Browse Musical Genres'}
             </h2>
           </div>
         {/* 4. Browse — explore by genre */}
         <section className="space-y-4">
           <div className="text-center mb-8">
             <div className="flex items-center justify-center gap-2 text-xs font-mono text-neutral-500 uppercase tracking-widest mb-1">
               <span>BROWSE</span>
             </div>
             <h2 className="font-serif text-2xl font-black text-cream-100">
               {locale === 'ne' ? 'सांगीतिक विधा वर्गीकरण' : 'Browse Musical Genres'}
             </h2>
           </div>

           <div className="space-y-6">
             {resolvedCategories.map((category) => {
               const categoryGenres = genres.filter((g) => g.category === category.slug);
               return (
                 <div key={category.slug} className="space-y-3">
                   <div className="flex items-center justify-between gap-3">
                     <h3 className="text-xs font-mono font-bold uppercase tracking-[0.3em] text-neutral-500">{category.label}</h3>
                     <span className="text-xs font-mono text-neutral-600">{categoryGenres.length} genres</span>
                   </div>
                   <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
                     {categoryGenres.map((g) => (
                       <button
                         key={g.slug}
                         onClick={() => onSelectGenre(g.slug)}
                         className="pd-lift p-3.5 rounded-xl bg-black hover:bg-white/4 border border-white/8 hover:border-white/20 text-left transition-all duration-200 ease-out hover:scale-105 active:scale-95 group"
                       >
                         <h4 className="font-serif text-xs font-bold text-white truncate group-hover:text-red-400 transition-colors">
                           {locale === 'ne' ? g.name_ne || g.name : g.name}
                         </h4>
                         <p className="text-xs text-red-400 font-mono mt-0.5 font-bold">
                           {category.label.toUpperCase()}
                         </p>
                       </button>
                     ))}
                   </div>
                 </div>
               );
             })}
           </div>
         </section>

           <div className="space-y-6">
             {resolvedCategories.map((category) => {
               const categoryGenres = genres.filter((g) => g.category === category.slug);
               return (
                 <div key={category.slug} className="space-y-3">
                   <div className="flex items-center justify-between gap-3">
                     <h3 className="text-xs font-mono font-bold uppercase tracking-[0.3em] text-neutral-500">{category.label}</h3>
                     <span className="text-xs font-mono text-neutral-600">{categoryGenres.length} genres</span>
                   </div>
                   <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
                     {categoryGenres.map((g) => (
                       <button
                         key={g.slug}
                         onClick={() => onSelectGenre(g.slug)}
                         className="pd-lift p-3.5 rounded-xl bg-black hover:bg-white/4 border border-white/8 hover:border-white/20 text-left transition-all duration-200 ease-out hover:scale-105 active:scale-95 group"
                       >
                         <h4 className="font-serif text-xs font-bold text-white truncate group-hover:text-red-400 transition-colors">
                           {locale === 'ne' ? g.name_ne || g.name : g.name}
                         </h4>
                         <p className="text-xs text-red-400 font-mono mt-0.5 font-bold">
                           {category.label.toUpperCase()}
                         </p>
                       </button>
                     ))}
                   </div>
                 </div>
               );
             })}
           </div>
         </section>

        {/* 6. FAQ Accordion */}
        <section className="mt-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
          <div className="text-center mb-8">
            <div className="flex items-center justify-center gap-2 text-xs font-mono text-neutral-500 uppercase tracking-widest mb-1">
              <span>FAQ</span>
            </div>
            <h2 className="font-serif text-2xl font-black text-cream-100">
              {locale === 'ne' ? 'प्रायः सोधिने प्रश्नहरू' : 'Frequently Asked Questions'}
            </h2>
          </div>

          <div className="space-y-3">
            {faqs.map((faq, idx) => {
              const isOpen = openFaq === idx;
              return (
                <div
                  key={idx}
                  className="rounded-xl bg-white/3 border border-white/8 overflow-hidden transition-all duration-200"
                >
                  <button
                    onClick={() => setOpenFaq(isOpen ? null : idx)}
                    className="w-full px-5 py-4 text-left flex items-center justify-between text-sm font-medium text-white hover:text-red-400 font-nepali transition-colors duration-150"
                  >
                    <span>{locale === 'ne' ? faq.q : faq.q_en}</span>
                    {isOpen ? <ChevronUp className="w-4 h-4 text-neutral-500" /> : <ChevronDown className="w-4 h-4 text-neutral-500" />}
                  </button>
                  {isOpen && (
                    <div className="px-5 pb-4 text-xs text-neutral-400 font-nepali leading-relaxed border-t border-white/5 pt-3">
                      {locale === 'ne' ? faq.a : faq.a_en}
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        </section>

        {/* 7. Recommend a song — listener contributions */}
        <RecommendSongSection />
      </Reveal>
    </div>
  );
};
