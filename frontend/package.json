{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node --experimental-strip-types scripts/prerender.ts",
    "build:spa": "tsc -b && vite build",
    "prerender": "node --experimental-strip-types scripts/prerender.ts",
    "typecheck:prerender": "tsc --ignoreConfig --noEmit --module nodenext --moduleResolution nodenext --allowImportingTsExtensions --target es2023 --lib es2023,dom --types node --skipLibCheck --strict scripts/prerender.ts",
    "test": "vitest run",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.54.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
