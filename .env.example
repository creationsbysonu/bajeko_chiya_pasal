[TEMPLATE]
# Purano Dhun Environment Configuration
# Copy to `.env` (docker compose and Django both read it).

# Django Core
DJANGO_SECRET_KEY=change-this-in-production-to-a-cryptographically-secure-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# HTTPS behavior (production). Set to True ONLY once HTTPS terminates in
# front of the app (certbot / cloud proxy / PaaS). Enabling it over plain
# HTTP breaks login because Django redirects everything to https://.
DJANGO_SSL_REDIRECT=False

# CORS & CSRF Trusted Origins (comma-separated; add your real domain in prod,
# e.g. https://yourdomain.com — same-origin nginx setups need no CORS entry)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Database (production stack: PostgreSQL via docker-compose.prod.yml.
# When unset, local dev falls back to SQLite at backend/db.sqlite3)
POSTGRES_PASSWORD=change-this-to-a-strong-database-password

# Production HTTP port for nginx (docker-compose.prod.yml)
HTTP_PORT=80

# Development stack port overrides (docker-compose.yml)
# BACKEND_PORT=8000
# FRONTEND_PORT=5173

# Admin Initial Credentials (documentation only — create real accounts with
# `python manage.py createsuperuser`)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_EMAIL=admin@puranodhun.org
