# Bajeko Chiya Pasal Environment Configuration
#
# The site is a Vite SPA talking directly to Supabase (database + backend).
# Copy to `.env` for local development; set the same two variables in the
# Vercel project settings for deploys.

# Supabase project → Settings → API
# Local development: `supabase start` prints these (or use the cloud project).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key

# Never put the service_role key here or anywhere in frontend code — it
# bypasses row-level security. The frontend only ever uses the anon key and
# goes through the locked-down RPC surface in supabase/migrations.
